#!/usr/bin/env bash

# =============================================================================
# Arch Linux Bootstrap Script
# =============================================================================

if [[ $EUID -eq 0 ]]; then
  echo "El script no debe ejecutarse como root. Saliendo..."
  exit 1
fi

# =============================================================================
# Versiones
# =============================================================================
NVM_VERSION="v0.40.2"
NODE_LTS_VERSION="22.14.0"
RBENV_VERSION="v1.3.2"
RUBY_LTS_VERSION="3.3.7"

# =============================================================================
# Instalación como root (paquetes del sistema)
# =============================================================================
install_root() {
  # Paquetes base del sistema
  pacman -S --needed \
    neovim \
    git \
    zsh \
    zoxide \
    make \
    bash \
    gcc \
    go \
    curl \
    base-devel \
    flatpak \
    firefox \
    chromium \
    fzf \
    btop \
    lazygit \
    jless \
    rbenv \
    exa \
    sassc \
    fd \
    fx \
    tmux \
    openvpn \
    slurp \
    grim \
    wl-clipboard \
    jq \
    extra/postgresql \
    blueman \
    thunar \
    vlc \
    ffmpeg \
    extra/mplayer \
    hyprlock \
    extra/gnome-calculator \
    rust-analyzer \
    evince \
    pandoc \
    texlive-meta
}

# =============================================================================
# nvm + Node.js LTS
# =============================================================================
nvm_setup() {
  local nvm_dir="$HOME/.nvm"

  if [ -d "$nvm_dir" ]; then
    echo "[INFO] nvm ya está instalado en $nvm_dir"
    return 0
  fi

  echo "[INFO] Instalando nvm $NVM_VERSION..."
  curl -o- "https://raw.githubusercontent.com/nvm-sh/nvm/$NVM_VERSION/install.sh" | bash

  # Cargar nvm inmediatamente para instalar Node.js
  export NVM_DIR="$HOME/.nvm"
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

  echo "[INFO] Instalando Node.js $NODE_LTS_VERSION (LTS)..."
  nvm install "$NODE_LTS_VERSION"
  nvm alias default "$NODE_LTS_VERSION"

  echo "[OK] nvm $NVM_VERSION y Node.js $NODE_LTS_VERSION instalados"
}

# =============================================================================
# rbenv + Ruby LTS
# =============================================================================
rbenv_setup() {
  local rbenv_dir="$HOME/.rbenv"

  if [ -d "$rbenv_dir" ]; then
    echo "[INFO] rbenv ya está instalado en $rbenv_dir"
    return 0
  fi

  echo "[INFO] Instalando rbenv $RBENV_VERSION..."
  git clone https://github.com/rbenv/rbenv.git "$rbenv_dir"
  cd "$rbenv_dir" && src/configure && make -C src

  # ruby-build plugin para instalar versiones de Ruby
  mkdir -p "$rbenv_dir/plugins"
  git clone https://github.com/rbenv/ruby-build.git "$rbenv_dir/plugins/ruby-build"

  # Cargar rbenv inmediatamente para instalar Ruby
  export PATH="$HOME/.rbenv/bin:$PATH"
  eval "$(rbenv init -)"

  echo "[INFO] Instalando Ruby $RUBY_LTS_VERSION..."
  rbenv install "$RUBY_LTS_VERSION"
  rbenv global "$RUBY_LTS_VERSION"

  echo "[OK] rbenv $RBENV_VERSION y Ruby $RUBY_LTS_VERSION instalados"
}

# =============================================================================
# Cargo / Rust (via rustup)
# =============================================================================
cargo_setup() {
  if command -v cargo >/dev/null 2>&1; then
    echo "[INFO] Cargo/Rust ya está instalado"
    return 0
  fi

  echo "[INFO] Instalando Rust y Cargo via rustup..."
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y

  # Cargar cargo inmediatamente
  . "$HOME/.cargo/env"

  echo "[OK] Rust y Cargo instalados correctamente"
}

# =============================================================================
# Flathub
# =============================================================================
flathub_setup() {
  echo "[INFO] Agregando repositorio Flathub (usuario)..."
  flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo

  echo "[INFO] Instalando Waterfox desde Flathub (usuario)..."
  flatpak install --user -y flathub net.waterfox.waterfox

  echo "[OK] Flathub configurado y Waterfox instalado (solo para el usuario)"
}

# =============================================================================
# Configuración de Zsh
# =============================================================================
zsh_setup() {
  local zshrc="$HOME/.zshrc"
  local zsh_bin
  zsh_bin="$(command -v zsh)"

  if [ -z "$zsh_bin" ]; then
    echo "[ERROR] zsh no está instalado. Saliendo..."
    return 1
  fi

  # Cambiar el shell por defecto a zsh si no es ya el actual
  if [ "$SHELL" != "$zsh_bin" ]; then
    echo "[INFO] Cambiando el shell por defecto a zsh..."
    if command -v chsh >/dev/null 2>&1; then
      chsh -s "$zsh_bin"
      echo "[OK] Shell cambiado a zsh. Los cambios se aplicarán al reiniciar sesión."
    else
      echo "[WARN] chsh no está disponible. Cambia el shell manualmente con: chsh -s $zsh_bin"
    fi
  else
    echo "[INFO] zsh ya es el shell por defecto."
  fi

  # Instalar Oh My Zsh
  local omz_dir="$HOME/.oh-my-zsh"
  if [ -d "$omz_dir" ]; then
    echo "[INFO] Oh My Zsh ya está instalado en $omz_dir"
  else
    echo "[INFO] Instalando Oh My Zsh..."
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
    echo "[OK] Oh My Zsh instalado correctamente"
  fi

  echo "[OK] Configuración adicional agregada a $zshrc"
}

# =============================================================================
# Catppuccin GTK Themes (Fausto-Korpsvart)
# =============================================================================
CATPPUCCIN_REPO="https://github.com/Fausto-Korpsvart/Catppuccin-GTK-Theme.git"
CATPPUCCIN_CLONE_DIR="/tmp/Catppuccin-GTK-Theme"

gtk_setup() {
  local clone_dir="$CATPPUCCIN_CLONE_DIR"

  if ! command -v git >/dev/null 2>&1; then
    echo "[ERROR] git no está instalado. No se pueden instalar los temas GTK."
    return 1
  fi

  if [ -d "$clone_dir" ]; then
    echo "[INFO] Repositorio ya clonado en $clone_dir. Eliminando para clonar de nuevo..."
    rm -rf "$clone_dir"
  fi

  echo "[INFO] Clonando Catppuccin GTK Theme..."
  git clone --depth=1 "$CATPPUCCIN_REPO" "$clone_dir"
  if [ $? -ne 0 ]; then
    echo "[ERROR] No se pudo clonar el repositorio."
    return 1
  fi

  echo "[INFO] Instalando temas Catppuccin (frappe, macchiato)..."
  cd "$clone_dir/themes" || {
    echo "[ERROR] No se encontró el directorio themes."
    return 1
  }

  ./install.sh --tweaks frappe macchiato -t all -l
  if [ $? -ne 0 ]; then
    echo "[ERROR] Falló la instalación de los temas."
    return 1
  fi

  echo "[OK] Temas Catppuccin GTK instalados correctamente"
}

# =============================================================================
# Nerd Fonts
# =============================================================================
NERD_FONTS_REPO="https://github.com/ryanoasis/nerd-fonts.git"
NERD_FONTS_DIR="$HOME/clones/nerd-fonts"

nerd_fonts_setup() {
  local clones_dir="$HOME/clones"
  local nf_dir="$NERD_FONTS_DIR"

  if ! command -v git >/dev/null 2>&1; then
    echo "[ERROR] git no está instalado. No se pueden instalar las Nerd Fonts."
    return 1
  fi

  mkdir -p "$clones_dir"

  if [ -d "$nf_dir" ]; then
    echo "[INFO] nerd-fonts ya está clonado en $nf_dir. Actualizando..."
    git -C "$nf_dir" pull --ff-only
    if [ $? -ne 0 ]; then
      echo "[WARN] No se pudo actualizar nerd-fonts. Continuando con la versión existente."
    fi
  else
    echo "[INFO] Clonando nerd-fonts..."
    git clone --depth=1 "$NERD_FONTS_REPO" "$nf_dir"
    if [ $? -ne 0 ]; then
      echo "[ERROR] No se pudo clonar nerd-fonts."
      return 1
    fi
  fi

  echo "[INFO] Instalando FiraCode y JetBrainsMono Nerd Fonts..."
  cd "$nf_dir" || {
    echo "[ERROR] No se encontró el directorio nerd-fonts."
    return 1
  }

  ./install.sh "FiraCode" "JetBrainsMono"
  if [ $? -ne 0 ]; then
    echo "[ERROR] Falló la instalación de las Nerd Fonts."
    return 1
  fi

  echo "[OK] Nerd Fonts instaladas correctamente"
}

# =============================================================================
# Tmux (TPM + Catppuccin theme)
# =============================================================================
TPM_DIR="$HOME/.tmux/plugins/tpm"
CATPPUCCIN_TMUX_DIR="$HOME/.config/tmux/plugins/catppuccin/tmux"

tmux_setup() {
  if ! command -v git >/dev/null 2>&1; then
    echo "[ERROR] git no está instalado. No se puede configurar tmux."
    return 1
  fi

  # TPM
  if [ -d "$TPM_DIR" ]; then
    echo "[INFO] TPM ya está instalado en $TPM_DIR"
  else
    echo "[INFO] Instalando TPM..."
    mkdir -p "$(dirname "$TPM_DIR")"
    git clone --depth=1 https://github.com/tmux-plugins/tpm "$TPM_DIR"
    if [ $? -ne 0 ]; then
      echo "[ERROR] No se pudo clonar TPM."
      return 1
    fi
    echo "[OK] TPM instalado"
  fi

  # Catppuccin tmux theme
  if [ -d "$CATPPUCCIN_TMUX_DIR" ]; then
    echo "[INFO] Catppuccin tmux theme ya está instalado en $CATPPUCCIN_TMUX_DIR"
  else
    echo "[INFO] Instalando Catppuccin tmux theme..."
    mkdir -p "$(dirname "$CATPPUCCIN_TMUX_DIR")"
    git clone --depth=1 -b v2.3.0 https://github.com/catppuccin/tmux.git "$CATPPUCCIN_TMUX_DIR"
    if [ $? -ne 0 ]; then
      echo "[ERROR] No se pudo clonar Catppuccin tmux."
      return 1
    fi
    echo "[OK] Catppuccin tmux theme instalado"
  fi

  echo "[OK] Tmux configurado correctamente"
}

# =============================================================================
# Neovim config
# =============================================================================
nvim_setup() {
  local nvim_dir="$HOME/.config/nvim"

  # Check if git is installed
  if ! command -v git >/dev/null 2>&1; then
    echo "[ERROR] git is not installed. Please install git to continue."
    return 1
  fi

  # Check if nvim configuration already exists
  if [ -d "$nvim_dir" ]; then
    echo "[INFO] The directory $nvim_dir already exists. Nothing will be downloaded."
    return 0
  fi

  # Create .config directory if it doesn't exist
  mkdir -p "$HOME/.config"

  # Clone the nvim config repository
  git clone https://github.com/alexandermiss/nvim "$nvim_dir"
  if [ $? -eq 0 ]; then
    echo "[OK] nvim configuration downloaded to $nvim_dir"
  else
    echo "[ERROR] Could not clone the repository."
    return 2
  fi
}

# =============================================================================
# AUR packages
# =============================================================================
AUR_PACKAGES=(
  "1password"
)

AUR_COMPILED=()

aur_setup() {
  local aur_dir="$HOME/aurs"

  if ! command -v makepkg >/dev/null 2>&1; then
    echo "[ERROR] makepkg no está disponible. Asegúrate de tener base-devel instalado."
    return 1
  fi

  mkdir -p "$aur_dir"

  for pkg in "${AUR_PACKAGES[@]}"; do
    local pkg_dir="$aur_dir/$pkg"

    if [ -d "$pkg_dir" ]; then
      echo "[INFO] $pkg ya está descargado en $pkg_dir"
      AUR_COMPILED+=("$pkg_dir")
      continue
    fi

    echo "[INFO] Descargando $pkg desde AUR..."
    git clone "https://aur.archlinux.org/${pkg}.git" "$pkg_dir"
    if [ $? -ne 0 ]; then
      echo "[ERROR] No se pudo clonar $pkg desde AUR"
      continue
    fi

    echo "[INFO] Compilando $pkg con makepkg..."
    (cd "$pkg_dir" && makepkg -s --noconfirm)
    if [ $? -ne 0 ]; then
      echo "[ERROR] No se pudo compilar $pkg"
      continue
    fi

    AUR_COMPILED+=("$pkg_dir")
    echo "[OK] $pkg compilado correctamente en $pkg_dir"
  done

  echo "[OK] Paquetes AUR procesados. Revisa $aur_dir para los binarios generados."
}

# =============================================================================
# GPG keys
# =============================================================================
GPG_APPS=(
  "1password:https://downloads.1password.com/linux/keys/1password.asc"
)

gpg_import() {
  if ! command -v gpg >/dev/null 2>&1; then
    echo "[ERROR] gpg no está disponible."
    return 1
  fi

  for entry in "${GPG_APPS[@]}"; do
    local app_name="${entry%%:*}"
    local app_url="${entry#*:}"

    echo "[INFO] Descargando clave GPG para $app_name..."
    local asc_file="/tmp/${app_name}.asc"
    curl -sS "$app_url" -o "$asc_file"
    if [ $? -ne 0 ]; then
      echo "[ERROR] No se pudo descargar la clave GPG de $app_name"
      continue
    fi

    echo "[INFO] Importando clave GPG de $app_name..."
    gpg --import "$asc_file"
    if [ $? -eq 0 ]; then
      echo "[OK] Clave GPG de $app_name importada correctamente"
    else
      echo "[ERROR] No se pudo importar la clave GPG de $app_name"
    fi

    rm -f "$asc_file"
  done
}

# =============================================================================
# Ejecución principal
# =============================================================================

# 1. Paquetes base del sistema (como root)
echo ""
echo "=========================================="
echo "  Paso 1: Instalando paquetes base..."
echo "=========================================="
su -c "$(declare -f install_root); install_root"

# 2. Rust / Cargo (como usuario) — debe ir antes de Zsh para que exista $HOME/.cargo/env
echo ""
echo "=========================================="
echo "  Paso 2: Instalando Rust + Cargo..."
echo "=========================================="
cargo_setup

# 3. Flathub + Waterfox (como root)
echo ""
echo "=========================================="
echo "  Paso 3: Configurando Flathub e instalando Waterfox..."
echo "=========================================="
flathub_setup

# 4. nvm + Node.js (como usuario)
echo ""
echo "=========================================="
echo "  Paso 4: Instalando nvm + Node.js LTS..."
echo "=========================================="
nvm_setup

# 5. rbenv + Ruby (como usuario)
echo ""
echo "=========================================="
echo "  Paso 5: Instalando rbenv + Ruby LTS..."
echo "=========================================="
rbenv_setup

# 6. Configurar Zsh (como usuario) — después de cargo/nvm/rbenv para que existan los archivos env
echo ""
echo "=========================================="
echo "  Paso 6: Configurando Zsh..."
echo "=========================================="
zsh_setup

# 7. Temas Catppuccin GTK (como usuario)
echo ""
echo "=========================================="
echo "  Paso 7: Instalando temas Catppuccin GTK (Fausto-Korpsvart)..."
echo "=========================================="
gtk_setup

# 8. Nerd Fonts (como usuario)
echo ""
echo "=========================================="
echo "  Paso 8: Instalando Nerd Fonts (FiraCode)..."
echo "=========================================="
nerd_fonts_setup

# 9. Tmux (TPM + Catppuccin) (como usuario)
echo ""
echo "=========================================="
echo "  Paso 9: Configurando Tmux (TPM + Catppuccin)..."
echo "=========================================="
tmux_setup

# 10. Importar claves GPG (como usuario)
echo ""
echo "=========================================="
echo "  Paso 10: Importando claves GPG..."
echo "=========================================="
gpg_import

# 11. AUR packages (como usuario)
echo ""
echo "=========================================="
echo "  Paso 11: Compilando paquetes AUR..."
echo "=========================================="
aur_setup

# 12. Neovim config (como usuario)
echo ""
echo "=========================================="
echo "  Paso 12: Configurando Neovim..."
echo "=========================================="
nvim_setup

echo ""
echo "=========================================="
echo "  ¡Instalación completada!"
echo "=========================================="
echo ""
echo "Versiones instaladas:"
echo "  nvm:     $NVM_VERSION"
echo "  Node.js: $NODE_LTS_VERSION (LTS)"
echo "  rbenv:   $RBENV_VERSION"
echo "  Ruby:    $RUBY_LTS_VERSION"
echo ""

if [ ${#AUR_COMPILED[@]} -gt 0 ]; then
  echo "Paquetes AUR compilados:"
  aur_files=()
  for pkg_dir in "${AUR_COMPILED[@]}"; do
    pkg_name="$(basename "$pkg_dir")"
    echo ""
    echo "  → $pkg_name"
    for pkg_file in "$pkg_dir"/*.pkg.tar.zst; do
      if [ -f "$pkg_file" ]; then
        pkg_size="$(du -h "$pkg_file" | cut -f1)"
        echo "      - $(basename "$pkg_file") ($pkg_size)"
        aur_files+=("$pkg_file")
      fi
    done
  done
  echo ""
  echo "Para instalar todos los paquetes AUR compilados, ejecuta:"
  echo "  su -c 'pacman -U ${aur_files[*]}'"
  echo ""
fi
